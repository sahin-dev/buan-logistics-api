model IntakeParcel {
    id            String             @id @default(uuid())
    intake_number String             @unique
    hubId         String
    hub           Hub                @relation(fields: [hubId], references: [id], onDelete: Cascade)
    full_name     String
    phone         String
    address       String
    package_info String?
    image_urls    String[]
    status        IntakeParcelStatus @default(AWAITING_PICKUP)
    handedOverAt  DateTime?
    arrivedAt     DateTime?
    createdAt     DateTime           @default(now())
    updatedAt     DateTime           @updatedAt

    @@index([hubId])
    @@index([intake_number])
    @@index([status])
    @@index([createdAt])
    @@map("intake_parcels")
}

enum IntakeParcelStatus {
    AWAITING_PICKUP
    HANDED_OVER
    ARRIVED_AT_BRANCH
}
